# Auto-generated by capacitor-store-deploy skill for Our Pregnancy (in.ourpregnancy.bloom)
opt_out_usage
default_platform(:ios)

require 'json'
require 'fileutils'

def load_deploy_config
  project_root = File.expand_path("../../..", __dir__)
  local_env = File.join(project_root, ".credentials", "env.json")
  global_env = File.expand_path("~/.capacitor-deploy/credentials/env.json")

  config = {}
  config.merge!(JSON.parse(File.read(global_env))) if File.exist?(global_env)
  config.merge!(JSON.parse(File.read(local_env))) if File.exist?(local_env)
  config
end

def load_asc_api_key
  project_root = File.expand_path("../../..", __dir__)
  cfg = load_deploy_config

  key_id = ENV["ASC_KEY_ID"] || cfg["ASC_KEY_ID"]
  issuer_id = ENV["ASC_ISSUER_ID"] || cfg["ASC_ISSUER_ID"]
  key_filepath = ENV["ASC_KEY_FILEPATH"] || cfg["ASC_KEY_FILEPATH"]

  if key_filepath.nil? || !File.exist?(key_filepath)
    p8_candidates = Dir.glob(File.join(project_root, ".credentials", "AuthKey_*.p8")) +
                    Dir.glob(File.expand_path("~/.capacitor-deploy/credentials/AuthKey_*.p8"))
    key_filepath = p8_candidates.first
    if key_id.nil? && key_filepath
      m = File.basename(key_filepath).match(/AuthKey_([A-Z0-9]+)\.p8/)
      key_id = m[1] if m
    end
  end

  if key_id.nil? || issuer_id.nil? || key_filepath.nil? || !File.exist?(key_filepath)
    UI.user_error!("❌ App Store Connect API Key (.p8, ASC_KEY_ID, ASC_ISSUER_ID) not found! Place your AuthKey_XXXX.p8 and env.json in #{project_root}/.credentials/ or ~/.capacitor-deploy/credentials/")
  end

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_filepath,
    in_house: false
  )
end

platform :ios do
  desc "Compile and export signed iOS .ipa archive"
  lane :build_ipa do
    project_root = File.expand_path("../../..", __dir__)

    UI.message("🔍 Running pre-flight version & guardrail checks...")
    sh("cd '#{project_root}' && node scripts/version-sync.mjs --check")

    UI.message("⚡ Building production web bundle & syncing Capacitor iOS...")
    sh("cd '#{project_root}' && npm run build && npx cap sync ios")

    # Ensure an Apple Distribution certificate exists in the local keychain (auto-create via ASC API if missing)
    api_key = load_asc_api_key
    UI.message("🔐 Verifying Apple Distribution certificate in Keychain...")
    get_certificates(
      api_key: api_key,
      development: false,
      skip_set_partition_list: true,
      output_path: File.join(project_root, ".credentials")
    )

    cfg = load_deploy_config
    xcargs = "-allowProvisioningUpdates DEVELOPMENT_TEAM=92U9QN6YGY"

    output_dir = File.join(project_root, "build", "ios")
    FileUtils.mkdir_p(output_dir)

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: output_dir,
      output_name: "OurPregnancy.ipa",
      clean: false,
      xcargs: xcargs,
      export_xcargs: "-allowProvisioningUpdates"
    )

    ipa_src = File.join(output_dir, "OurPregnancy.ipa")
    root_ipa = File.join(project_root, "OurPregnancy.ipa")
    if File.exist?(ipa_src)
      FileUtils.cp(ipa_src, root_ipa)
      UI.success("✅ Exported signed iOS IPA to #{root_ipa}")
    end
  end

  desc "Build signed .ipa and upload directly to Apple TestFlight"
  lane :deploy_testflight do
    api_key = load_asc_api_key
    build_ipa

    project_root = File.expand_path("../../..", __dir__)
    ipa_path = File.join(project_root, "OurPregnancy.ipa")

    UI.message("🚀 Uploading #{ipa_path} to Apple TestFlight...")
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
    UI.success("🎉 Successfully uploaded Our Pregnancy to Apple TestFlight!")
  end

  desc "Build signed .ipa and upload to App Store Connect for review"
  lane :deploy_appstore do
    api_key = load_asc_api_key
    build_ipa

    project_root = File.expand_path("../../..", __dir__)
    ipa_path = File.join(project_root, "OurPregnancy.ipa")

    UI.message("🚀 Uploading #{ipa_path} to App Store Connect...")
    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true
    )
    UI.success("🎉 Successfully uploaded Our Pregnancy to App Store Connect!")
  end
end
