{
  "name": "projectbloom",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sukratkaushik/projectbloom.git"
  },
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:rules": "tsx --test test/firestore.rules.test.ts",
    "test:delete": "tsx --test test/deleteAccount.test.ts",
    "test:consent": "tsx --test test/consentPersistence.test.ts",
    "test:ai-consent": "tsx --test test/aiConsent.test.ts",
    "cap:sync": "npm run build && cap sync android",
    "cap:open:android": "cap open android",
    "cap:build:android": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "cap:sync:ios": "npm run build && cap sync ios",
    "cap:open:ios": "cap open ios",
    "cap:build:ios": "npm run build && cap sync ios && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -destination 'generic/platform=iOS Simulator' build",
    "postbuild": "react-snap || exit 0",
    "release:status": "node scripts/version-sync.mjs --status",
    "release:version": "node scripts/version-sync.mjs",
    "release:android:build": "cd android && fastlane build_and_sync",
    "release:android:alpha": "cd android && fastlane deploy_play track:alpha",
    "release:android:internal": "cd android && fastlane deploy_play track:internal",
    "release:android:play": "cd android && fastlane deploy_play",
    "release:ios:build": "cd ios/App && fastlane build_ipa",
    "release:ios:testflight": "cd ios/App && fastlane deploy_testflight",
    "release:ios:appstore": "cd ios/App && fastlane deploy_appstore",
    "release:all": "npm run release:android:alpha && npm run release:ios:testflight"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/health-fitness": "^1.0.1",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.3",
    "@revenuecat/purchases-capacitor": "^14.0.0",
    "@sentry/browser": "^10.49.0",
    "@sentry/react": "^10.49.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "peerjs": "^1.5.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "uuid": "14.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/peerjs": "^0.0.30",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "react-snap": "^1.23.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.2"
  },
  "reactSnap": {
    "source": "dist",
    "skipThirdPartyRequests": true
  }
}
