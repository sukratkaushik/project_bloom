opt_out_usage
default_platform(:android)

require 'json'
require 'fileutils'

# Auto-resolve JAVA_HOME on macOS so Gradle works headlessly without manual shell exports
if ENV["JAVA_HOME"].nil? || ENV["JAVA_HOME"].empty?
  jdk_candidates = [
    "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
    "/Applications/Android Studio.app/Contents/jbr/Contents/Home",
    "/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home"
  ]
  found_jdk = jdk_candidates.find { |p| File.exist?(p) }
  if found_jdk
    ENV["JAVA_HOME"] = found_jdk
    ENV["PATH"] = "#{found_jdk}/bin:#{ENV['PATH']}"
  end
end

def load_deploy_config
  project_root = File.expand_path("../..", __dir__)
  local_env = File.join(project_root, ".credentials", "env.json")
  global_env = File.expand_path("~/.capacitor-deploy/credentials/env.json")

  config = {}
  config.merge!(JSON.parse(File.read(global_env))) if File.exist?(global_env)
  config.merge!(JSON.parse(File.read(local_env))) if File.exist?(local_env)
  config
end

def resolve_play_json_key
  project_root = File.expand_path("../..", __dir__)
  cfg = load_deploy_config
  candidates = [
    ENV["PLAY_JSON_KEY_FILE"],
    cfg["PLAY_JSON_KEY_FILE"],
    File.join(project_root, ".credentials", "play-service-account.json"),
    File.expand_path("~/.capacitor-deploy/credentials/play-service-account.json")
  ].compact

  found = candidates.find { |p| File.exist?(p) }
  UI.user_error!("❌ Google Play Service Account JSON key not found! Place 'play-service-account.json' in #{project_root}/.credentials/ or ~/.capacitor-deploy/credentials/") unless found
  found
end

