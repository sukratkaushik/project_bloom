      FileUtils.cp(aab_src, root_aab)
      UI.success("✅ Copied signed AAB to #{root_aab}")
    end
  end

  desc "Promote or upload existing signed AAB directly to Google Play Store without rebuilding"
  lane :upload_only do |options|
    track = options[:track] || ENV["TRACK"] || "alpha"
